[Unit]
Description=AgentBoundary Agent Rush backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Edit these 3 placeholders to match your VM account and installation.
User=YOUR_LINUX_USER
WorkingDirectory=/home/YOUR_LINUX_USER/agentboundary-agent-rush
EnvironmentFile=/home/YOUR_LINUX_USER/agentboundary-agent-rush/.env
Environment=PATH=/home/YOUR_LINUX_USER/agentboundary-agent-rush/.venv/bin:/usr/bin:/bin
Environment=DOCKER_HOST=unix:///run/user/YOUR_UID/docker.sock
ExecStart=/home/YOUR_LINUX_USER/agentboundary-agent-rush/.venv/bin/uvicorn agentboundary.server:app --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=4
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
